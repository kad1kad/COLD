# the Sub page: EDIT's fourth page (after Play 2), only where the engine has a second page of knobs (rayon);
# rayon's: fall, floor and keyscale (TP_X1..X3), and the screen reader says them; another engine, or another track, takes
# the page away
wait 300
spin ALGO 2
expect trk 3
knob 3 engine jacquard
tap EDIT
expect page Engine
turn SELECT 1
expect page Play
turn SELECT 1
expect page Play_2
expect par3.oct 2
turn SELECT 1
expect page Engine
# rayon: fall, floor and keyscale, a fourth page
knob 3 engine rayon
expect par3.engine 1
expect par3.x1 0
expect par3.x2 0
listen
turn SELECT 3
expect page Sub
wait 400
said Sub
shot sub_off.png
spin K1 40
expect par3.x1 40
wait 400
said fall
spin K2 50
expect par3.x2 50
spin K3 40
expect par3.x3 40
wait 40
shot sub_layers.png
spin K1 -30
expect par3.x1 10
spin K1 300
expect par3.x1 127
spin K1 -117
expect par3.x1 10
# the list: the Sub page's knobs among EDIT's
tap SEL
wait 40
shot sub_list.png
tap HOME
# a note with the layers on
key 7 down
wait 200
expect voices 1
key 7 up
wait 300
turn SELECT 1
expect page Engine
turn SELECT -1
expect page Sub
# another track (jacquard: no Sub page): back to the button's first page
spin ALGO 1
expect trk 4
expect page Engine
spin ALGO -1
expect trk 3
turn SELECT -1
expect page Sub
# another engine on the Sub page (jacquard): back to Engine, three pages
knob 3 engine jacquard
expect page Engine
turn SELECT 1
expect page Play
turn SELECT 1
expect page Play_2
turn SELECT 1
expect page Engine
