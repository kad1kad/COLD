# ALGORITHM: the tracks that play on every page (T1-T5, THROW; the conductor is hidden), Mix's strips on Mix (T1-T5, FX I, FX II); off Mix
# an FX track gives way to the instrument picked last
wait 300
expect trk 1
turn ALGO -1
expect trk 7
turn ALGO -1
expect trk 5
turn ALGO 2
expect trk 1
tap GLO
turn ALGO -1
expect trk 9
turn ALGO -1
expect trk 8
turn ALGO -1
expect trk 5
turn ALGO 1
expect trk 8
tap SEQ
expect trk 5
tap GLO
turn ALGO 3
expect trk 1
