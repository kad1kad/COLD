# live recording: REC + PLAY starts from step 1 and records at once (the transport starts only from PLAY);
# a chord on a track lands on the step playing; REC held while
# playing records while held; REC held shows the record settings on the knobs, and a hold toggles nothing
wait 300
turn ALGO 1
expect trk 2
tap SEQ
press REC
tap PLAY
release REC
expect playing 1
wait 480
key 0 down
key 4 down
key 7 down
wait 120
key 0 up
key 4 up
key 7 up
wait 300
tap PLAY
expect playing 0
expect note 2 1 6 53
# again over it: the second chord lands on the step it was played on, the first stays
press REC
tap PLAY
release REC
wait 480
key 2 down
key 5 down
key 9 down
wait 120
key 2 up
key 5 up
key 9 up
wait 300
tap PLAY
expect note 2 1 5 55
expect note 2 1 6 53
# REC held, stopped: the record settings; turning them, or just holding, toggles nothing
press REC
turn K1 1
turn K2 1
wait 60
shot rec_knobs.png
release REC
press REC
wait 600
release REC
wait 60
shot after_hold.png
expect playing 0
